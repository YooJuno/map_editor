{
  "name": "map-editor-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --project demo-map-editor --only auth,firestore 'vitest run tests/rules.test.ts tests/firebase.test.ts tests/workspaces.test.ts'",
    "deploy": "npm run build && firebase deploy --project map-editor-juno --only hosting,firestore",
    "firebase": "firebase"
  },
  "dependencies": {
    "firebase": "13.3.0",
    "fflate": "^0.8.2",
    "lucide-react": "^0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.3.0",
    "firebase-tools": "^15.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "jsdom": "^27.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  }
}
