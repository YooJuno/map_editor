/* Neutral light surfaces with restrained slate accents. */
QWidget { color: #3f3f3f; selection-background-color: #e2e8f0; selection-color: #35455a; }
QMainWindow, QDialog, QMessageBox { background: #f6f6f6; }
QMainWindow::separator { width: 1px; height: 1px; background: #dfdfdf; }
QMenuBar { background: #f6f6f6; color: #7c7c7c; padding: 3px 10px; border-bottom: 1px solid #e6e6e6; }
QMenuBar::item { padding: 4px 9px; background: transparent; border-radius: 4px; }
QMenuBar::item:selected { background: #e9edf3; color: #35455a; }
QMenu { background: #fbfbfb; border: 1px solid #dddddd; padding: 6px; }
QMenu::item { padding: 8px 28px 8px 26px; border-radius: 4px; }
QMenu::item:selected { background: #e8edf4; }
QMenu::item:disabled { color: #a8a8a8; }
QMenu::separator { height: 1px; background: #e4e4e4; margin: 5px; }
QToolTip { background: #fdfdfd; color: #3e3e3e; border: 1px solid #d2d2d2; padding: 7px 10px; }
QToolBar { background: #f6f6f6; border: 0; spacing: 6px; }
QToolBar#fileToolbar { padding: 10px 14px; border-bottom: 1px solid #dfdfdf; }
QToolBar#drawingToolbar { padding: 3px 4px; border-bottom: 1px solid #dfdfdf; background: #f1f1f1; }
QToolBar#toolsRail { border-right: 1px solid #dfdfdf; }
QToolBar::separator { width: 1px; height: 22px; background: #dfdfdf; margin: 6px; }
QFrame#toolbarDivider, QFrame#railDivider, QFrame#sectionRule { background: #e0e0e0; border: 0; }
QFrame#railDivider, QFrame#sectionRule { max-height: 1px; min-height: 1px; }
QLabel#brandLabel { color: #3e3e3e; font-size: 15px; font-weight: 600; }
QLabel#documentTitle { font-weight: 600; padding: 0 5px; }
QLabel#documentState { color: #828282; font-size: 11px; padding: 0 8px; }
QLabel#toolTitle { font-weight: 600; color: #535353; }
QLabel#toolContext { color: #828282; font-size: 11px; padding-right: 8px; }
QPushButton, QToolButton { background: #fbfbfb; border: 1px solid #dcdcdc; border-radius: 5px; padding: 6px 10px; min-height: 20px; }
QPushButton:hover, QToolButton:hover { background: #eeeeee; border-color: #c7c7c7; }
QPushButton:pressed, QToolButton:pressed { background: #dfe7f2; border-color: #a6b7ce; }
QPushButton:focus, QToolButton:focus { border-color: #93a9c6; }
QPushButton:disabled, QToolButton:disabled { color: #aeaeae; background: #f3f3f3; border-color: #e5e5e5; }
QToolBar QToolButton, QStatusBar QToolButton { background: transparent; border: 1px solid transparent; padding: 6px 9px; }
QToolBar QToolButton:hover, QStatusBar QToolButton:hover { background: #ebebeb; border-color: #dcdcdc; }
QToolBar QToolButton:disabled, QStatusBar QToolButton:disabled { background: transparent; border-color: transparent; }
QToolButton#primarySave { background: #e5ebf3; border: 1px solid #b6c2d2; color: #3b506c; padding: 6px 9px; font-weight: 600; }
QToolButton#primarySave:hover { background: #dce5f1; border-color: #9eafc6; }
QToolButton#primarySave:disabled { background: #f0f0f0; border-color: #dedede; color: #a3a3a3; }
QToolButton#saveOptions::menu-indicator { image: none; }
QPushButton[primary="true"] { background: #5b708f; border-color: #5b708f; color: #ffffff; font-weight: 600; }
QPushButton[primary="true"]:hover { background: #4e6380; border-color: #4e6380; }
QPushButton[primary="true"]:disabled { background: #eaeaea; border-color: #e1e1e1; color: #a9a9a9; }
QPushButton[drawingTool="true"] { border: 1px solid transparent; border-radius: 6px; background: transparent; padding: 0; min-height: 44px; max-height: 44px; min-width: 44px; max-width: 44px; }
QPushButton[drawingTool="true"]:hover { background: #ececec; border-color: #e1e1e1; }
QPushButton[drawingTool="true"]:checked { background: #dfe7f2; border-color: #a7b8cf; }
QPushButton[drawingTool="true"]:focus { border-color: #8eabc9; }
QPushButton[drawingTool="true"]:disabled { background: transparent; border-color: transparent; }
QPushButton[swatch="true"] { background: transparent; padding: 2px 7px; border-color: transparent; }
QPushButton[swatch="true"]:hover { background: #e8e8e8; border-color: #d6d6d6; }
QPushButton[swatch="true"]:checked { background: #fbfbfb; border-color: #9aabc2; color: #35465e; }
QPushButton#resetGray { background: transparent; border-color: transparent; color: #757575; padding: 4px; }
QPushButton#clearMask, QPushButton#closeMasks { background: transparent; border-color: transparent; color: #737373; }
QPushButton#clearMask:hover, QPushButton#closeMasks:hover { background: #ebebeb; color: #6c6c6c; }
QDockWidget { background: #f8f8f8; border-left: 1px solid #dfdfdf; }
QWidget#inspectorHeader, QWidget#inspectorPanel, QScrollArea#inspectorScroll { background: #f8f8f8; }
QWidget#inspectorHeader { border-bottom: 1px solid #e4e4e4; }
QToolButton#hideInspector { background: transparent; border-color: transparent; padding: 0; min-height: 20px; }
QLabel#sectionTitle { color: #6f6f6f; font-weight: 600; font-size: 11px; }
QLabel#fileName { color: #323944; font-weight: 600; font-size: 14px; }
QLabel#documentDetails { color: #818181; font-size: 11px; }
QLabel#paletteStatus, QLabel#radians, QLabel#instructions { color: #7f7f7f; font-size: 11px; }
QLabel#metadataState { color: #858585; font-size: 11px; }
QGroupBox { border: 0; margin-top: 6px; padding-top: 6px; }
QGroupBox::title { subcontrol-origin: margin; left: 0; padding: 0; color: #838383; font-size: 11px; }
QToolButton#advancedToggle { border: 0; background: transparent; color: #757575; text-align: left; padding: 5px 0; }
QSpinBox, QDoubleSpinBox, QComboBox, QLineEdit { background: #ffffff; border: 1px solid #e0e0e0; border-radius: 4px; padding: 6px 8px; min-height: 20px; color: #3e4858; }
QSpinBox:hover, QDoubleSpinBox:hover, QComboBox:hover, QLineEdit:hover { border-color: #c0c0c0; }
QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus, QLineEdit:focus { border-color: #9f9f9f; }
QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled, QLineEdit:disabled { background: #f3f3f3; border-color: #e6e6e6; color: #a8a8a8; }
QSpinBox::up-button, QDoubleSpinBox::up-button { subcontrol-origin: border; subcontrol-position: top right; width: 20px; border: 0; margin-top: 1px; margin-right: 1px; }
QSpinBox::down-button, QDoubleSpinBox::down-button { subcontrol-origin: border; subcontrol-position: bottom right; width: 20px; border: 0; margin-bottom: 1px; margin-right: 1px; }
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow { image: url(:/arrow-up-light.png); width: 10px; height: 6px; }
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow { image: url(:/arrow-down-light.png); width: 10px; height: 6px; }
QSpinBox::up-arrow:disabled, QDoubleSpinBox::up-arrow:disabled { image: url(:/arrow-up-disabled-light.png); }
QSpinBox::down-arrow:disabled, QDoubleSpinBox::down-arrow:disabled { image: url(:/arrow-down-disabled-light.png); }
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover, QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover { background: #f0f0f0; }
QComboBox { padding-right: 24px; }
QComboBox::drop-down { border: 0; width: 24px; }
QComboBox::down-arrow { image: url(:/arrow-down-light.png); width: 10px; height: 6px; }
QComboBox::down-arrow:disabled { image: url(:/arrow-down-disabled-light.png); }
QComboBox QAbstractItemView { background: #fbfbfb; color: #3c4a60; border: 1px solid #d2d2d2; selection-background-color: #eaeaea; selection-color: #354b68; outline: 0; padding: 4px; }
QComboBox QAbstractItemView::item { padding: 7px; min-height: 22px; }
QCheckBox { spacing: 7px; color: #757575; padding: 3px 0; }
QCheckBox:disabled { color: #acacac; }
QCheckBox::indicator { width: 15px; height: 15px; border: 1px solid #cccccc; border-radius: 3px; background: #ffffff; }
QCheckBox::indicator:checked { background: #7186a2; border-color: #7186a2; image: url(:/check.png); }
QCheckBox::indicator:disabled { border-color: #e0e0e0; background: #f0f0f0; }
QCheckBox::indicator:checked:disabled { image: url(:/check.png); background: #cbcbcb; }
QSlider::groove:horizontal { height: 3px; background: #e1e1e1; border-radius: 1px; }
QSlider::sub-page:horizontal { background: #859ab6; border-radius: 1px; }
QSlider::handle:horizontal { background: #ffffff; border: 1px solid #a0b2c9; width: 11px; margin: -5px 0; border-radius: 6px; }
QSlider::handle:horizontal:hover { border-color: #7c96b8; }
QSlider::groove:horizontal:disabled, QSlider::sub-page:horizontal:disabled { background: #e7e7e7; }
QSlider::handle:horizontal:disabled { border-color: #d6d6d6; }
QScrollBar:vertical { background: transparent; width: 7px; margin: 0; }
QScrollBar::handle:vertical { background: #d6d6d6; border-radius: 3px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: #bbbbbb; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QScrollBar:horizontal { height: 7px; background: transparent; }
QScrollBar::handle:horizontal { background: #d6d6d6; border-radius: 3px; min-width: 30px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QStatusBar { background: #f4f4f4; border-top: 1px solid #e0e0e0; padding: 0 8px; }
QStatusBar::item { border: 0; }
QLabel#coordinates { color: #828282; font-size: 11px; }
QLabel#zoomLabel { color: #636363; font-size: 11px; }
QLabel:disabled { color: #a9a9a9; }

QToolBar#navigationRail { background: #efefef; border-right: 1px solid #dfdfdf; }
QPushButton[navigation="true"] { min-width: 68px; max-width: 68px; min-height: 60px; max-height: 60px; padding: 0; background: transparent; border-color: transparent; }
QPushButton[navigation="true"]:hover { background: #e8e8e8; border-color: #d6d6d6; }
QPushButton[navigation="true"]:checked { background: #dfe7f2; border-color: #a7b8cf; }
QPushButton[navigation="true"]:disabled { background: transparent; border-color: transparent; }

QPushButton#color0, QPushButton#color1, QPushButton#color2, QPushButton#pickerTool { padding: 0; }
QLabel#navigationHint { font-size: 10px; color: #7c8798; }
