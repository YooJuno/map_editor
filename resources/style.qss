QToolBar { border: 0; border-bottom: 1px solid #c5c5c5; spacing: 3px; padding: 3px; }
QToolBar QPushButton { padding: 3px 6px; }
QPushButton:checked { background: #d7e6f5; border: 1px solid #6a92b8; }
QDockWidget::title { padding: 5px 8px; background: #e2e2e2; }
QGroupBox { margin-top: 10px; }
QGroupBox::title { subcontrol-origin: margin; left: 8px; padding: 0 3px; }
QLabel#paletteStatus, QLabel#radians { color: #666666; }
QStatusBar::item { border: 0; }
