QMainWindow, QDialog { background: #f7f9f7; color: #24382e; }
QWidget { font-size: 12px; color: #24382e; }
QFrame#header { background: #ffffff; border-bottom: 1px solid #dce5df; }
QLabel#brand { font-size: 23px; font-weight: 700; letter-spacing: -0.5px; color: #174d39; }
QLabel#brandTag { font-size: 9px; letter-spacing: 1.2px; color: #6c8275; }
QLabel#fileName { font-size: 13px; font-weight: 600; }
QLabel#hint { font-size: 11px; color: #718378; line-height: 1.5; }
QLabel#sectionTitle { font-size: 12px; font-weight: 700; color: #355743; padding-top: 2px; }
QFrame#toolsPanel, QFrame#propertiesPanel, QScrollArea#propertiesScroll { background: #f8faf8; }
QLabel#metadataState { font-size: 10px; color: #678273; }
QFrame#separator { border: none; background: #dce5df; max-height: 1px; }
QPushButton { background: #ffffff; border: 1px solid #cfdbd3; border-radius: 6px; padding: 8px 11px; color: #355743; }
QPushButton:hover { background: #edf6ef; border-color: #89b49e; }
QPushButton:pressed { background: #d9eee1; }
QPushButton:disabled { color: #9bada0; background: #f0f4f0; border-color: #e0e7e1; }
QPushButton[tool="true"] { text-align: left; border-color: transparent; background: transparent; padding-left: 12px; }
QPushButton[tool="true"]:hover { background: #e9f2eb; }
QPushButton[tool="true"]:checked { background: #dcefe3; border-color: #badbc7; color: #176641; font-weight: 600; }
QPushButton#primary { background: #237852; color: white; border: 1px solid #237852; padding-left: 22px; padding-right: 22px; font-weight: 600; }
QPushButton#primary:hover { background: #196443; }
QPushButton#applyMetadata:enabled { background: #e0f0e6; color: #176641; }
QSpinBox, QDoubleSpinBox, QComboBox { background: white; border: 1px solid #cddbd1; border-radius: 5px; padding: 6px; min-height: 18px; selection-background-color: #267a54; }
QDoubleSpinBox:focus, QSpinBox:focus, QComboBox:focus { border-color: #3d9a6b; }
QComboBox QAbstractItemView { background: white; selection-background-color: #dcefe3; selection-color: #174d39; }
QSlider::groove:horizontal { height: 5px; background: #d3e1d7; border-radius: 2px; }
QSlider::handle:horizontal { background: #2c8058; border: 2px solid #fff; width: 13px; height: 13px; margin: -6px 0; border-radius: 8px; }
QCheckBox { spacing: 6px; font-size: 11px; }
QCheckBox::indicator { width: 14px; height: 14px; border-radius: 3px; border: 1px solid #b2c9ba; background: white; }
QCheckBox::indicator:checked { background: #2b8058; border-color: #2b8058; image: url(:/check.png); }
QMenuBar { background: #f9fbf9; border-bottom: 1px solid #dce5df; padding: 2px 10px; }
QMenuBar::item:selected { background: #e0eee4; }
QMenu { background: white; border: 1px solid #cfdbd3; padding: 5px; }
QMenu::item { padding: 7px 28px 7px 15px; }
QMenu::item:selected { background: #e0eee4; }
QStatusBar { background: #f8faf8; border-top: 1px solid #d5e0d8; }
QStatusBar::item { border: none; }
QStatusBar QLabel { font-size: 10px; }
QSplitter::handle { background: #dce5df; width: 1px; }
QScrollBar:vertical { background: #f0f4f1; width: 8px; }
QScrollBar::handle:vertical { background: #b9cdc0; border-radius: 4px; min-height: 30px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QToolTip { color: #f7faf7; background: #254e39; border: none; padding: 6px; }
